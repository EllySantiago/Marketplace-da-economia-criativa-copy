# Endereço da API vista pelo navegador. Padrão: /api (o próprio site, que repassa para a API pelo
# rewrite do next.config.mjs). Só troque se quiser chamar a API direto, com CORS.
NEXT_PUBLIC_API_URL=/api

# Para onde o rewrite /api repassa. Padrão em desenvolvimento: http://localhost:3333 (npm run api no
# backend). Na Vercel: a URL da API no Render (docs/deploy.md).
API_URL=http://localhost:3333
